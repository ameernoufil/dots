#!/usr/bin/env python3
"""Stamp sidebar position numbers onto herdr spaces and agent panes as an $idx token.

Herdr renders position numbers only in the collapsed sidebar; the expanded sidebar
builds rows from tokens and has no index token. Custom metadata tokens do render as
$name, so this daemon reports each space's and each agent pane's current sidebar
position as the token "idx".
"""

from __future__ import annotations

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from herdr_numbering import (  # noqa: E402
    agent_order,
    agent_panel_sort,
    machines,
    run,
    snapshot,
    visible_workspace_order,
)

SOURCE = "sidebar-numbers"
TOKEN = "idx"

# (machine, kind) -> {target: number}; machine None is Local.
Numbers = dict[tuple[str | None, str], dict[str, str]]


def desired_numbers(sort: str) -> Numbers:
    """Number Local first, then each SSH machine, continuing the count like the sidebar."""
    numbers: Numbers = {}
    next_space = next_agent = 1
    for machine in [None, *machines()]:
        try:
            snap = snapshot(machine)
        except RuntimeError as error:
            if machine is None:
                raise
            print(f"herdr-sidebar-numbers: skipping {machine}: {error}", file=sys.stderr, flush=True)
            continue
        workspaces = snap.get("workspaces", [])
        order = visible_workspace_order(workspaces)
        numbers[(machine, "workspace")] = {
            workspaces[i]["workspace_id"]: str(n) for n, i in enumerate(order, start=next_space)
        }
        agents = agent_order(snap.get("agents", []), sort)
        numbers[(machine, "pane")] = {
            a["pane_id"]: str(n) for n, a in enumerate(agents, start=next_agent)
        }
        next_space += len(order)
        next_agent += len(agents)
    return numbers


def stamp(machine: str | None, kind: str, target: str, value: str | None) -> None:
    args = [kind, "report-metadata", target, "--source", SOURCE]
    args += ["--clear-token", TOKEN] if value is None else ["--token", f"{TOKEN}={value}"]
    run(args, machine)


def sync(previous: Numbers, sort: str) -> Numbers:
    current = desired_numbers(sort)
    for key in current.keys() | previous.keys():
        machine, kind = key
        old, new = previous.get(key, {}), current.get(key, {})
        for target, value in new.items():
            if old.get(target) != value:
                stamp(machine, kind, target, value)
        for target in old.keys() - new.keys():
            try:
                stamp(machine, kind, target, None)
            except RuntimeError:
                pass  # target or machine is gone
    return current


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--interval", type=float, default=2.0, help="seconds between polls")
    parser.add_argument("--once", action="store_true", help="stamp once and exit")
    args = parser.parse_args()

    sort = agent_panel_sort()
    previous: Numbers = {}
    while True:
        try:
            previous = sync(previous, sort)
        except Exception as error:  # server restart, socket churn, transient CLI failure
            print(f"herdr-sidebar-numbers: {error}", file=sys.stderr, flush=True)
            previous = {}
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    sys.exit(main())
