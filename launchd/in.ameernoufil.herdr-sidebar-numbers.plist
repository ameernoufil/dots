<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>in.ameernoufil.herdr-sidebar-numbers</string>
  <!-- Homebrew python: /usr/bin/python3 is 3.9, which has no tomllib and silently falls back to the wrong sort. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/ameer.noufil/dotfiles/bin/herdr-sidebar-numbers</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ameer.noufil/.config/herdr/sidebar-numbers.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ameer.noufil/.config/herdr/sidebar-numbers.log</string>
</dict>
</plist>
